import java.util.*;
public class ProductElements{
  public static void main(String[] args){
    Scanner sc=new Scanner(System.in);
    int n=sc.nextInt();
    int a[]=new int[n];
    for(int i=0;i<n;i++){
      a[i]=sc.nextInt();
    }
    int right[n];
    int left[n];
    right[n-1]=1;
    for(int i=0;i<n;i++){
      right[i]=right[i+1]*a[i+1];
    }
    left[0]=1;
    for(int i=0;i<n;i++){
      left[i]=left[i-1]*a[i-1];
    }
    for(int i=0;i<n;i++){
      System.out.println(left[i]+" "+right[i);
    }
  }
}
